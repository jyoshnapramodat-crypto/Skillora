PORT=5000

# MongoDB Connection String
# For MongoDB Atlas (Recommended for Render / Production):
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillora?retryWrites=true&w=majority&appName=SkilloraCluster
#
# For Local MongoDB Compass / Dev:
MONGODB_URI=mongodb://127.0.0.1:27017/skillora

# JWT Security
JWT_SECRET=skillora_jwt_super_secret_production_key_2026_change_me
JWT_EXPIRE=30d

# Node Environment
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials (Optional Override)
ADMIN_EMAIL=admin@skillora.dev
ADMIN_PASSWORD=Admin@Skillora2026!
ADMIN_NAME="Skillora Administrator"
